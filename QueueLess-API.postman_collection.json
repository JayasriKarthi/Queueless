{
  "info": {
    "name": "QueueLess API (Phases 1-6)",
    "description": "Run the folders in order (or the whole collection with the Runner). Start the backend first with `npm run dev` on Node 22.\n\n'1. Sign up' creates a new test email each time, so the collection can be run again and again. Password reset needs one manual step: copy the token from the email printed in the server terminal into the `resetToken` collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "Sunrise#2024"
    },
    {
      "key": "newPassword",
      "value": "New-Password-1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": "PASTE_TOKEN_FROM_SERVER_TERMINAL"
    }
  ],
  "item": [
    {
      "name": "A. Basics",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('ok is true', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/nothing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "nothing"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code is NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Broken JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{oops",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code is INVALID_JSON', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_JSON'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "B. Sign up",
      "item": [
        {
          "name": "1. Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Owner\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"businessName\": \"Postman Test Clinic\",\n  \"businessType\": \"clinic\",\n  \"terms\": true,\n  \"plan\": \"pro\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', `owner${Date.now()}@test.example`);",
                  "pm.collectionVariables.set('password', 'Sunrise#2024');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('ok is true', () => pm.expect(pm.response.json().ok).to.eql(true));",
                  "if (pm.response.code < 300) pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "const b = pm.response.json();",
                  "pm.test('user is an owner without a password hash', () => { pm.expect(b.user.role).to.eql('owner'); pm.expect(JSON.stringify(b)).to.not.include('passwordHash'); });",
                  "pm.test('business starts on Free, not live, with the clinic template', () => { pm.expect(b.business.plan).to.eql('free'); pm.expect(b.business.isLive).to.eql(false); pm.expect(b.business.intendedPlan).to.eql('pro'); pm.expect(b.business.labels.resourcePlural).to.eql('Doctors'); });",
                  "pm.test('refresh cookie was set', () => pm.expect(pm.cookies.has('ql_refresh')).to.be.true);",
                  "pm.test('home is the onboarding page', () => pm.expect(b.home).to.eql('/onboarding/welcome'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Sign up again with the same email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Owner\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"businessName\": \"Postman Test Clinic\",\n  \"businessType\": \"clinic\",\n  \"terms\": true,\n  \"plan\": \"pro\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code is EMAIL_TAKEN', () => pm.expect(pm.response.json().error.code).to.eql('EMAIL_TAKEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Sign up with invalid fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nope\",\n  \"terms\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error code is VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));",
                  "pm.test('every bad field is listed', () => { const f = pm.response.json().error.details.map((d) => d.field); ['name','email','password','businessName','businessType','terms'].forEach((k) => pm.expect(f).to.include(k)); });"
                ]
              }
            }
          ]
        }
      ]
    },

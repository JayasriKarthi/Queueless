              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('ok is true', () => pm.expect(pm.response.json().ok).to.eql(true));",
                  "if (pm.response.code < 300) pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "pm.test('owner goes to /admin', () => pm.expect(pm.response.json().home).to.eql('/admin'));"
                ]
              }
            }
          ]
        }
      ]
    },
